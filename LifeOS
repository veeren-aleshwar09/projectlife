<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>LifeOS</title>

    <!-- Google Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- CSS -->
    <link rel="stylesheet" href="css/style.css">
</head>

<body>
    <div class="container">
        <!-- Sidebar -->
        <aside class="sidebar">
            <div class="logo">
                <h2>LifeOS</h2>
            </div>

            <ul class="menu">
                <li class="active">Dashboard</li>
                <li>Tasks</li>
                <li>Goals</li>
                <li>Workout</li>
                <li>Diet</li>
                <li>Water</li>
                <li>Notes</li>
                <li>Pomodoro</li>
                <li>Analytics</li>
                <li>Settings</li>
            </ul>
        </aside>

        <!-- Main Content -->
        <main class="main">
            <!-- Navbar -->
            <header class="navbar">
                <input type="text" placeholder="Search...">
                <div class="profile">
                    <span>👋 Aleshwar</span>
                </div>
            </header>

            <!-- Dashboard -->
            <section class="dashboard">
                <h1>Welcome Back 👋</h1>
                <p>Ready to build a better version of yourself today?</p>

                <div class="cards">
                    <div class="card">
                        <h3>Total Tasks</h3>
                        <h2 id="totalTasks">0</h2>
                    </div>

                    <div class="card">
                        <h3>Completed</h3>
                        <h2 id="completedTasks">0</h2>
                    </div>

                    <div class="card">
                        <h3>Pending</h3>
                        <h2 id="pendingTasks">0</h2>
                    </div>

                    <div class="card">
                        <h3>Progress</h3>
                        <h2 id="progressPercent">0%</h2>
                    </div>
                </div>

                <div class="progress-section">

                    <div class="progress-header">
                        <h2>Today's Progress</h2>
                        <span id="progressText">0%</span>
                    </div>

                    <div class="progress-bar">

                        <div id="progressFill" class="progress-fill"></div>

                    </div>

                </div>

                <!-- Task Section -->
                <div class="task-section">
                    <div class="task-header">
                        <h2>Today's Tasks</h2>
                        <button id="addTaskBtn">
                            + Add Task
                        </button>
                    </div>

                    <div class="task-input">
                        <input
                            id="taskInput"
                            type="text"
                            placeholder="Enter a new task..."
                        >
                    </div>

                    <div id="taskList" class="task-list">
                    </div>
                </div>

                <!-- ===========================
                     Goals Section
                =========================== -->

                <section class="goal-section">

                    <div class="goal-header">

                        <h2>Goals</h2>

                        <button id="addGoalBtn">
                            + Add Goal
                        </button>

                    </div>

                    <div class="goal-inputs">

                        <input
                            type="text"
                            id="goalInput"
                            placeholder="Enter your goal..."
                        >

                        <input
                            type="date"
                            id="goalDate"
                        >

                        <select id="goalPriority">

                            <option value="High">High Priority</option>
                            <option value="Medium">Medium Priority</option>
                            <option value="Low">Low Priority</option>

                        </select>

                    </div>

                    <div id="goalList" class="goal-list">

                    </div>

                </section>

                <!-- ===========================
                     Workout Section
                =========================== -->

                <section class="workout-section">

                    <div class="workout-header">

                        <h2>Workout Tracker</h2>

                        <button id="addWorkoutBtn">
                            + Add Workout
                        </button>

                    </div>

                    <div class="workout-inputs">

                        <input
                            id="exerciseInput"
                            type="text"
                            placeholder="Exercise Name"
                        >

                        <input
                            id="durationInput"
                            type="number"
                            placeholder="Minutes"
                        >

                        <input
                            id="calorieInput"
                            type="number"
                            placeholder="Calories"
                        >

                    </div>

                    <div id="workoutList"></div>

                </section>

                <!-- ===========================
                     Diet Section
                =========================== -->

                <section class="diet-section">

                    <div class="diet-header">

                        <h2>Diet Tracker</h2>

                        <button id="addMealBtn">
                            + Add Meal
                        </button>

                    </div>

                    <div class="diet-inputs">

                        <input
                            type="text"
                            id="mealInput"
                            placeholder="Meal Name"
                        >

                        <select id="mealType">

                            <option>Breakfast</option>
                            <option>Lunch</option>
                            <option>Dinner</option>
                            <option>Snack</option>

                        </select>

                        <input
                            type="number"
                            id="mealCalories"
                            placeholder="Calories"
                        >

                    </div>

                    <div id="mealList"></div>

                </section>

            </section>
        </main>
    </div>

    <script src="js/tasks.js"></script>
    <script src="js/goals.js"></script>
    <script src="js/workout.js"></script>
    <script src="js/diet.js"></script>
</body>
</html>


// Greeting

function greeting(){

const h=new Date().getHours();

const g=document.getElementById("greeting");

if(h<12) g.innerHTML="Good Morning ☀️";

else if(h<18) g.innerHTML="Good Afternoon 🌤️";

else g.innerHTML="Good Evening 🌙";

}

greeting();

// Clock

function clock(){

document.getElementById("clock").innerHTML=
new Date().toLocaleTimeString();

}

clock();

setInterval(clock,1000);

// ----------------------
// TASK MANAGER
// ----------------------

let tasks=JSON.parse(localStorage.getItem("tasks")) || [];

const taskInput=document.getElementById("taskInput");

const addBtn=document.getElementById("addTask");

const taskList=document.getElementById("taskList");

const search=document.getElementById("searchTask");

function save(){

localStorage.setItem("tasks",JSON.stringify(tasks));

}

function render(){

taskList.innerHTML="";

const keyword=search.value.toLowerCase();

tasks.forEach((task,index)=>{

if(!task.text.toLowerCase().includes(keyword)) return;

const li=document.createElement("li");

li.className="task";

li.innerHTML=`

<span class="${task.done ? "completed":""}">
${task.text}
</span>

<button class="delete">Delete</button>

`;

li.querySelector("span").onclick=()=>{

task.done=!task.done;

save();

render();

};

li.querySelector("button").onclick=()=>{

tasks.splice(index,1);

save();

render();

};

taskList.appendChild(li);

});

}

addBtn.onclick=()=>{

const text=taskInput.value.trim();

if(text==="") return;

tasks.push({

text,

done:false

});

taskInput.value="";

save();

render();

};

search.oninput=render;

render();
/* ===========================
   Google Font
=========================== */

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:'Poppins',sans-serif;
}

body{

    background:#0B0F19;
    color:white;
}

.container{

    display:flex;
    min-height:100vh;
}


/* ===========================
   Sidebar
=========================== */

.sidebar{

    width:250px;
    background:#111827;

    padding:30px;

    display:flex;
    flex-direction:column;

    border-right:1px solid rgba(255,255,255,.05);
}

.logo{

    font-size:24px;
    font-weight:700;
    color:#6366F1;

    margin-bottom:50px;
}

.menu{

    list-style:none;
}

.menu li{

    padding:15px;

    margin-bottom:10px;

    border-radius:12px;

    cursor:pointer;

    transition:.3s;
}

.menu li:hover{

    background:#6366F1;
}

.menu .active{

    background:#6366F1;
}


/* ===========================
   Main
=========================== */

.main{

    flex:1;

    padding:40px;
}


/* ===========================
   Navbar
=========================== */

.navbar{

    display:flex;

    justify-content:space-between;

    align-items:center;

    margin-bottom:40px;
}

.navbar input{

    width:320px;

    padding:14px;

    border:none;

    outline:none;

    border-radius:12px;

    background:#1F2937;

    color:white;
}

.profile{

    background:#1F2937;

    padding:12px 20px;

    border-radius:12px;
}


/* ===========================
   Dashboard
=========================== */

.dashboard h1{

    font-size:36px;

    margin-bottom:10px;
}

.dashboard p{

    color:#9CA3AF;

    margin-bottom:40px;
}


/* ===========================
   Cards
=========================== */

.cards{

    display:grid;

    grid-template-columns:repeat(4,1fr);

    gap:20px;

    margin-bottom:50px;
}

.card{

    background:#1F2937;

    padding:30px;

    border-radius:18px;

    transition:.3s;

    cursor:pointer;
}

.card:hover{

    transform:translateY(-8px);

    box-shadow:0 15px 35px rgba(99,102,241,.35);
}

.card h3{

    color:#9CA3AF;

    margin-bottom:15px;
}

.card h2{

    font-size:34px;
}


/* ===========================
   Tasks
=========================== */

.task-section{

    background:#1F2937;

    padding:30px;

    border-radius:18px;
}

.task-header{

    display:flex;

    justify-content:space-between;

    align-items:center;

    margin-bottom:25px;
}

.task-header button{

    background:#6366F1;

    color:white;

    border:none;

    padding:12px 20px;

    border-radius:10px;

    cursor:pointer;

    transition:.3s;
}

.task-header button:hover{

    background:#4F46E5;
}

.task{

    display:flex;

    align-items:center;

    gap:15px;

    padding:18px;

    border-radius:12px;

    margin-bottom:12px;

    background:#111827;

    transition:.3s;
}

.task:hover{

    transform:translateX(6px);
}


/* ===========================
   Responsive
=========================== */

@media(max-width:1100px){

.cards{

grid-template-columns:repeat(2,1fr);

}

}

@media(max-width:800px){

.sidebar{

display:none;

}

.main{

padding:20px;

}

.cards{

grid-template-columns:1fr;

}

.navbar{

flex-direction:column;

gap:20px;

}

.navbar input{

width:100%;

}

}

.task-input{

    margin-bottom:20px;
}

.task-input input{

    width:100%;

    padding:15px;

    border:none;

    outline:none;

    border-radius:12px;

    background:#111827;

    color:white;

    font-size:16px;
}

.task button.delete{

    margin-left:auto;

    background:#EF4444;

    color:white;

    border:none;

    padding:8px 14px;

    border-radius:8px;

    cursor:pointer;
}

.task.completed span{

    text-decoration:line-through;

    opacity:.6;
}

.task span{

cursor:pointer;

font-size:18px;

}

.completed{

text-decoration:line-through;

opacity:.5;

}

.delete{

background:red;

color:white;

border:none;

padding:10px 15px;

border-radius:10px;

cursor:pointer;

}

@keyframes fade{

from{

opacity:0;

transform:translateY(10px);

}

to{

opacity:1;

transform:translateY(0);

}

}
